# Polyglot Swarm — production/staging configuration template (ADR-0035).
# Copy to the host as .env.production (never commit the real file) and fill
# in every <...>. Validate before deploying:
#   docker compose -f docker-compose.prod.yml run --rm api polyglot ops config-check
# Secrets belong in the host's secret store / environment, not in the image.

# or: staging
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
API_DOCS_ENABLED=false
CORS_ORIGINS=https://<your-app-domain>
TELEMETRY_ENABLED=true

# LLM providers (at least one). LOCAL_ONLY=true keeps learner text on-premises.
ANTHROPIC_API_KEY=<secret>
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
LOCAL_ONLY=false
POLYGLOT_DETERMINISTIC=0

# Reliability and cost governance
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_CALLS_PER_TURN=16
LLM_USER_DAILY_BUDGET_USD=1.0
LLM_USER_DAILY_CALLS=1000
LLM_GLOBAL_DAILY_BUDGET_USD=<daily cap in USD, e.g. 50>
USER_RATE_LIMIT_PER_MINUTE=60
MAX_REQUEST_BYTES=16777216
MAX_ACTIVE_SESSIONS_PER_USER=5
SESSION_IDLE_FINALIZE_HOURS=6

# Security
MIN_PASSWORD_LENGTH=10
# 7 days; shorter limits a stolen token
TOKEN_TTL_HOURS=168
METRICS_TOKEN=<random, at least 24 characters>
# only if you run the Gradio UI: user:password
GRADIO_AUTH=

# Data (inside the container; /data is the mounted volume)
DATA_DIR=/data
DB_PATH=/data/polyglot.db
CHROMA_PATH=/data/chroma
PROFILES_DIR=/data/user_profiles
BACKUP_RETENTION_COUNT=14
MAINTENANCE_INTERVAL_SECONDS=900
