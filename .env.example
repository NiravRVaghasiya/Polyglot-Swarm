# Polyglot Swarm — configuration
#
#   1. Copy this file to .env
#        Windows:        copy .env.example .env
#        macOS / Linux:  cp .env.example .env
#   2. Choose ONE way for the tutor to think (option A, B or C below).
#   3. Run `polyglot health` - it checks your choice and says what is missing.
#
# Everything below the options can stay as it is.

# === Option A: a hosted AI model (best quality; needs an API key, pay per use)
# Any one key is enough. Claude handles conversation, Gemini quick grammar
# checks, and OpenAI is a fallback; with several keys they back each other up.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# === Option B: a free local model with Ollama (private; ~8 GB of free memory)
# Install Ollama from https://ollama.com, then run once:  ollama pull llama3.1:8b
# Leave these as they are unless Ollama runs on another machine or port.
OLLAMA_BASE_URL=http://localhost:11434
LLM_LOCAL=ollama/llama3.1:8b
# Context window requested from Ollama; larger values need far more memory.
OLLAMA_NUM_CTX=8192

# === Option C: offline demo (no AI; canned replies, for trying the interface)
# Set to 1 to use a built-in fake model. Set back to 0 once option A or B works.
POLYGLOT_DETERMINISTIC=0

# === Learning ===

# Default target language (any language name, e.g. Spanish, Japanese, Arabic)
DEFAULT_LANGUAGE=Spanish

# FSRS desired retention (0.0 to 1.0)
FSRS_DESIRED_RETENTION=0.9

# === Models (advanced) ===
# Which hosted model each tier uses when its key is set.
LLM_PRIMARY=claude-sonnet-5-5
LLM_FAST=gemini-3.6-flash

# === Privacy ===

# Local-only mode: when true, the provider factory excludes every hosted
# provider (Claude/Gemini/OpenAI) regardless of which API keys are set, leaving
# only local Ollama — an enforced "no learning data leaves this machine".
LOCAL_ONLY=false

# Whether LLM-call telemetry (latency/tokens/estimated cost — no message
# content) is persisted to the model_runs table across restarts.
TELEMETRY_ENABLED=true

# Bearer-token lifetime (hours) before a token expires and stops resolving.
TOKEN_TTL_HOURS=720

# === Server ===

# API server
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins allowed to call the API (comma-separated; the React dev
# server by default). Leave empty to disable CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gradio UI
GRADIO_SERVER_PORT=7860

# === Storage ===

# Database path (SQLite)
DB_PATH=./data/polyglot.db

# ChromaDB path
CHROMA_PATH=./data/chroma

# === Logging ===
LOG_LEVEL=INFO
# "text" for human-readable local dev logs, "json" for structured
# (log-aggregator-friendly) production logs
LOG_FORMAT=text

# === Reliability ===
# Bounded retries of the SAME LLM provider (with exponential backoff) before
# failing over to the next one in the chain. Errors that can't succeed on a
# retry (missing model, bad key) fail over immediately.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.2
LLM_RETRY_MAX_DELAY=2.0
# Circuit breaker: skip a provider after this many consecutive failures, for
# this many seconds, instead of retrying it on every subsequent turn
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# === Voice (optional) ===

# LiveKit credentials (for voice mode)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
