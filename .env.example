# Polyglot Swarm — Environment Configuration
# Copy this file to .env and fill in your values

# === LLM Providers (at least one required) ===

# Anthropic (Claude) — recommended for conversation quality
ANTHROPIC_API_KEY=sk-ant-...

# Google (Gemini Flash) — fast + cheap for grammar checks
GOOGLE_API_KEY=AIza...

# OpenAI (optional fallback)
OPENAI_API_KEY=sk-...

# Ollama (local, no key needed — just run `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434

# === Configuration ===

# Default target language (any language name — e.g., Spanish, Japanese, Polish, Arabic)
DEFAULT_LANGUAGE=Spanish

# LLM routing strategy
LLM_PRIMARY=claude-sonnet-4-20250514
LLM_FAST=gemini-2.0-flash
LLM_LOCAL=ollama/llama3.1:8b

# FSRS desired retention (0.0 to 1.0)
FSRS_DESIRED_RETENTION=0.9

# === Logging ===
LOG_LEVEL=INFO
# "text" for human-readable local dev logs, "json" for structured
# (log-aggregator-friendly) production logs
LOG_FORMAT=text

# === Reliability ===
# Bounded retries of the SAME LLM provider (with exponential backoff) before
# failing over to the next one in the chain
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=0.2
LLM_RETRY_MAX_DELAY=2.0
# Circuit breaker: skip a provider after this many consecutive failures, for
# this many seconds, instead of retrying it on every subsequent turn
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30.0

# === Voice (optional) ===

# LiveKit credentials (for voice mode)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# === Storage ===

# Database path (SQLite)
DB_PATH=./data/polyglot.db

# ChromaDB path
CHROMA_PATH=./data/chroma

# === Server ===

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Gradio UI
GRADIO_SERVER_PORT=7860

# === Privacy (optional) ===

# Local-only mode: when true, the provider factory excludes every hosted
# provider (Claude/Gemini/OpenAI) regardless of which API keys are set, leaving
# only local Ollama — an enforced "no learning data leaves this machine".
LOCAL_ONLY=false

# Whether LLM-call telemetry (latency/tokens/estimated cost — no message
# content) is persisted to the model_runs table across restarts.
TELEMETRY_ENABLED=true

# Bearer-token lifetime (hours) before a token expires and stops resolving.
TOKEN_TTL_HOURS=720
